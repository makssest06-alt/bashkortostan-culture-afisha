{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:afisha:identity-fixtures:v1",
  "title": "Synthetic event identity pair and cluster fixtures",
  "description": "The root validates clusters.json. Validate each pairs.jsonl line against #/$defs/pairCase.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "synthetic",
    "scenarios"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "synthetic": {
      "const": true
    },
    "scenarios": {
      "type": "array",
      "minItems": 12,
      "items": {
        "$ref": "#/$defs/clusterCase"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^(syn|[A-Z]{3})[-_][A-Za-z0-9._:-]+$"
    },
    "nullableString": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence": {
      "type": "string",
      "enum": [
        "same_source_event_key",
        "same_source_occurrence_key",
        "same_shared_event_id",
        "same_shared_occurrence_id",
        "same_ical_uid_recurrence_id",
        "same_ical_uid",
        "same_production",
        "same_work",
        "same_canonical_venue",
        "same_instant",
        "text_similarity",
        "description_similarity",
        "price_similarity",
        "same_series",
        "source_absence_context",
        "sparse_attributes"
      ]
    },
    "veto": {
      "type": "string",
      "enum": [
        "conflicting_shared_event_ids",
        "conflicting_shared_occurrence_ids",
        "conflicting_productions",
        "conflicting_works",
        "conflicting_cities",
        "conflicting_canonical_venues",
        "parent_child_relation",
        "different_series_members",
        "different_stable_occurrence_keys",
        "different_recurrence_ids",
        "distinct_languages",
        "distinct_halls",
        "time_precision_mismatch",
        "timezone_missing",
        "strong_identity_conflict"
      ]
    },
    "pairRef": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "offer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount_minor",
        "currency",
        "audience",
        "fees_included"
      ],
      "properties": {
        "amount_minor": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "audience": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "fees_included": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "source_id",
        "namespace",
        "external_event_id",
        "external_occurrence_id",
        "shared_event_id",
        "shared_occurrence_id",
        "ical_uid",
        "recurrence_id",
        "title",
        "normalized_title",
        "work_id",
        "production_id",
        "venue_id",
        "city",
        "hall",
        "start_utc",
        "start_local_raw",
        "previous_start_local_raw",
        "timezone",
        "precision",
        "status",
        "event_kind",
        "language",
        "age_rating",
        "relation_to_other",
        "description",
        "offers",
        "sequence",
        "observed_at",
        "last_seen_at",
        "run_completeness",
        "presence",
        "end_utc",
        "end_local_raw",
        "series_id"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "pattern": "^[A-Z]{3}-[0-9]{3}-[LR]$"
        },
        "source_id": {
          "type": "string",
          "pattern": "^syn_src_[a-z0-9_]+$"
        },
        "namespace": {
          "type": "string",
          "pattern": "^syn_ns_[a-z0-9_]+$"
        },
        "external_event_id": {
          "$ref": "#/$defs/nullableString"
        },
        "external_occurrence_id": {
          "$ref": "#/$defs/nullableString"
        },
        "shared_event_id": {
          "$ref": "#/$defs/nullableString"
        },
        "shared_occurrence_id": {
          "$ref": "#/$defs/nullableString"
        },
        "ical_uid": {
          "$ref": "#/$defs/nullableString"
        },
        "recurrence_id": {
          "$ref": "#/$defs/nullableString"
        },
        "title": {
          "$ref": "#/$defs/nullableString"
        },
        "normalized_title": {
          "$ref": "#/$defs/nullableString"
        },
        "work_id": {
          "$ref": "#/$defs/nullableString"
        },
        "production_id": {
          "$ref": "#/$defs/nullableString"
        },
        "venue_id": {
          "$ref": "#/$defs/nullableString"
        },
        "city": {
          "$ref": "#/$defs/nullableString"
        },
        "hall": {
          "$ref": "#/$defs/nullableString"
        },
        "start_utc": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "start_local_raw": {
          "$ref": "#/$defs/nullableString"
        },
        "previous_start_local_raw": {
          "$ref": "#/$defs/nullableString"
        },
        "timezone": {
          "$ref": "#/$defs/nullableString"
        },
        "precision": {
          "enum": [
            "second",
            "minute",
            "date",
            "month",
            "naive_datetime",
            "unknown"
          ]
        },
        "status": {
          "enum": [
            "unknown",
            "tentative",
            "scheduled",
            "postponed",
            "rescheduled",
            "cancelled",
            "moved_online"
          ]
        },
        "event_kind": {
          "enum": [
            "standalone",
            "performance_run",
            "exhibition",
            "festival",
            "series_member",
            "online_run"
          ]
        },
        "language": {
          "$ref": "#/$defs/nullableString"
        },
        "age_rating": {
          "$ref": "#/$defs/nullableString"
        },
        "relation_to_other": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "part_of",
                "same_work",
                "same_production",
                "series_member",
                "related"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "$ref": "#/$defs/nullableString"
        },
        "offers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/offer"
          }
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "observed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_seen_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "run_completeness": {
          "enum": [
            "complete",
            "partial",
            "failed"
          ]
        },
        "presence": {
          "enum": [
            "present",
            "explicit_tombstone",
            "not_observed"
          ]
        },
        "end_utc": {
          "$ref": "#/$defs/nullableString"
        },
        "end_local_raw": {
          "$ref": "#/$defs/nullableString"
        },
        "series_id": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "gold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "occurrence"
      ],
      "properties": {
        "event": {
          "enum": [
            "same",
            "different"
          ]
        },
        "occurrence": {
          "enum": [
            "same",
            "different",
            "not_applicable"
          ]
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate",
        "event_action",
        "occurrence_action",
        "projection_notes"
      ],
      "properties": {
        "candidate": {
          "type": "boolean"
        },
        "event_action": {
          "enum": [
            "merge",
            "separate",
            "review"
          ]
        },
        "occurrence_action": {
          "enum": [
            "merge",
            "separate",
            "review",
            "not_applicable"
          ]
        },
        "projection_notes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "status_conflict_review",
              "no_cancellation_inference",
              "unknown_not_scheduled",
              "unknown_not_free",
              "preserve_distinct_offers",
              "no_min_price",
              "sanitize_description",
              "preserve_raw",
              "age_conflict_review",
              "time_conflict_review",
              "venue_conflict_review",
              "per_field_survivorship",
              "opaque_external_id"
            ]
          }
        }
      }
    },
    "pairCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "synthetic",
        "category",
        "split",
        "family_id",
        "title",
        "scenario",
        "left",
        "right",
        "evidence",
        "vetoes",
        "gold",
        "expected"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^(EXT|TXT|OCC|TIM|VEN|WRK|SER|STS|PRC|SPR|CFG|SEC)-[0-9]{3}$"
        },
        "synthetic": {
          "const": true
        },
        "category": {
          "enum": [
            "EXT",
            "TXT",
            "OCC",
            "TIM",
            "VEN",
            "WRK",
            "SER",
            "STS",
            "PRC",
            "SPR",
            "CFG",
            "SEC"
          ]
        },
        "split": {
          "enum": [
            "dev",
            "test"
          ]
        },
        "family_id": {
          "type": "string",
          "pattern": "^syn_family_[0-9]{2}$"
        },
        "title": {
          "type": "string",
          "minLength": 5
        },
        "scenario": {
          "type": "string",
          "minLength": 20
        },
        "left": {
          "$ref": "#/$defs/observation"
        },
        "right": {
          "$ref": "#/$defs/observation"
        },
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "vetoes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/veto"
          }
        },
        "gold": {
          "$ref": "#/$defs/gold"
        },
        "expected": {
          "$ref": "#/$defs/expected"
        }
      }
    },
    "clusterRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "source_id",
        "external_event_id",
        "external_occurrence_id",
        "namespace",
        "shared_event_id",
        "shared_occurrence_id",
        "ical_uid",
        "recurrence_id",
        "production_id",
        "work_id",
        "venue_id",
        "city",
        "start_utc",
        "relation_to_other",
        "event_kind",
        "series_id",
        "language",
        "hall",
        "precision",
        "timezone"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "source_id": {
          "type": "string",
          "pattern": "^syn_src_[a-z0-9_]+$"
        },
        "external_event_id": {
          "$ref": "#/$defs/nullableString"
        },
        "external_occurrence_id": {
          "$ref": "#/$defs/nullableString"
        },
        "namespace": {
          "type": "string",
          "pattern": "^syn_ns_[a-z0-9_]+$"
        },
        "shared_event_id": {
          "$ref": "#/$defs/nullableString"
        },
        "shared_occurrence_id": {
          "$ref": "#/$defs/nullableString"
        },
        "ical_uid": {
          "$ref": "#/$defs/nullableString"
        },
        "recurrence_id": {
          "$ref": "#/$defs/nullableString"
        },
        "production_id": {
          "$ref": "#/$defs/nullableString"
        },
        "work_id": {
          "$ref": "#/$defs/nullableString"
        },
        "venue_id": {
          "$ref": "#/$defs/nullableString"
        },
        "city": {
          "$ref": "#/$defs/nullableString"
        },
        "start_utc": {
          "$ref": "#/$defs/nullableString"
        },
        "relation_to_other": {
          "$ref": "#/$defs/observation/properties/relation_to_other"
        },
        "event_kind": {
          "$ref": "#/$defs/observation/properties/event_kind"
        },
        "series_id": {
          "$ref": "#/$defs/nullableString"
        },
        "language": {
          "$ref": "#/$defs/nullableString"
        },
        "hall": {
          "$ref": "#/$defs/nullableString"
        },
        "timezone": {
          "$ref": "#/$defs/nullableString"
        },
        "precision": {
          "$ref": "#/$defs/observation/properties/precision"
        }
      }
    },
    "clusterPair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left",
        "right",
        "event_action",
        "occurrence_action",
        "evidence",
        "vetoes",
        "score"
      ],
      "properties": {
        "left": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "right": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "event_action": {
          "enum": [
            "merge",
            "separate",
            "review"
          ]
        },
        "occurrence_action": {
          "enum": [
            "merge",
            "separate",
            "review",
            "not_applicable"
          ]
        },
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "vetoes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/veto"
          }
        },
        "score": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "membership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "record_ids"
      ],
      "properties": {
        "entity_id": {
          "type": "string",
          "pattern": "^syn_(merged|split|original)_[a-z0-9_]+$"
        },
        "record_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      }
    },
    "historyOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "type",
        "level",
        "input_entity_ids",
        "output_entity_ids",
        "memberships_before",
        "memberships_after",
        "created_at"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^syn_op_[a-z0-9_]+$"
        },
        "type": {
          "enum": [
            "merge",
            "split"
          ]
        },
        "level": {
          "enum": [
            "event",
            "occurrence"
          ]
        },
        "input_entity_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "output_entity_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "memberships_before": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/membership"
          }
        },
        "memberships_after": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/membership"
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "historyRedirect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_id",
        "to_id",
        "replacement_ids"
      ],
      "properties": {
        "from_id": {
          "type": "string"
        },
        "to_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "replacement_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "to_id": {
                "type": "null"
              }
            },
            "required": [
              "to_id"
            ]
          },
          "then": {
            "properties": {
              "replacement_ids": {
                "minItems": 2
              }
            }
          },
          "else": {
            "properties": {
              "replacement_ids": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operations",
        "redirects"
      ],
      "properties": {
        "operations": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/historyOperation"
          }
        },
        "redirects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/historyRedirect"
          }
        }
      }
    },
    "redirectExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_id",
        "terminal_id",
        "replacement_ids"
      ],
      "properties": {
        "from_id": {
          "type": "string"
        },
        "terminal_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "replacement_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "clusterExpected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolution",
        "public_clusters",
        "public_occurrence_clusters",
        "required_pairs",
        "forbidden_pairs",
        "required_occurrence_pairs",
        "forbidden_occurrence_pairs",
        "order_invariant",
        "redirect_resolution"
      ],
      "properties": {
        "resolution": {
          "enum": [
            "commit",
            "review"
          ]
        },
        "public_clusters": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          }
        },
        "public_occurrence_clusters": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          }
        },
        "required_pairs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pairRef"
          }
        },
        "forbidden_pairs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pairRef"
          }
        },
        "required_occurrence_pairs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pairRef"
          }
        },
        "forbidden_occurrence_pairs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pairRef"
          }
        },
        "order_invariant": {
          "const": true
        },
        "redirect_resolution": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/redirectExpectation"
          }
        }
      }
    },
    "clusterCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "synthetic",
        "title",
        "scenario",
        "records",
        "input_order",
        "permutations",
        "pairs",
        "expected"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^CL-[0-9]{3}$"
        },
        "synthetic": {
          "const": true
        },
        "title": {
          "type": "string",
          "minLength": 5
        },
        "scenario": {
          "type": "string",
          "minLength": 20
        },
        "records": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/clusterRecord"
          }
        },
        "input_order": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "permutations": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          }
        },
        "pairs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/clusterPair"
          }
        },
        "expected": {
          "$ref": "#/$defs/clusterExpected"
        },
        "history": {
          "$ref": "#/$defs/history"
        }
      }
    }
  }
}
