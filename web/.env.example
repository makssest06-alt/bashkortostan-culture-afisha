# Режим данных. Пока значение не равно live, сайт показывает пометку «Демо-данные».
NEXT_PUBLIC_DATA_MODE=demo

# Адрес Telegram-бота вида https://t.me/имя_бота. Пока не задан, ссылка ведёт на https://t.me/
NEXT_PUBLIC_TELEGRAM_BOT_URL=

# Админка /admin. Токен модератора от 12 знаков. Без токена в боевой сборке админка выключена,
# при локальной разработке открыта в демо-режиме. Значение не коммитить.
ADMIN_TOKEN=
# Где хранить правки, импорт и журнал, пока нет бэкенда. По умолчанию .next/cache/afisha/admin-state.json
AFISHA_DATA_FILE=
