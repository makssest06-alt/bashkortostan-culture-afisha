# Переменные окружения сайта афиши. Скопируйте в .env.local и заполните.
# Реальные токены и ключи в репозиторий не кладутся: .env.local и .env в .gitignore.
#
# Переменные с приставкой NEXT_PUBLIC_ вшиваются в сборку: после изменения
# заново выполните `npm run build` (в Docker это аргументы сборки, см. compose.yaml).

# ── Откуда брать данные ───────────────────────────────────────────────
# Адрес бэка без /api/v1 на конце, например http://localhost:8000 или https://api.afisha.example.
# Пусто: сайт работает на моках из этого же приложения (src/app/api/v1), бэк не нужен.
# Задан: страницы ходят в бэк с сервера сайта, а запросы браузера и виджета к /api/v1/* сайт
# пересылает в бэк. Адрес должен открываться с сервера сайта (в docker compose: http://api:8000);
# снаружи бэк может быть закрыт, CORS не нужен.
NEXT_PUBLIC_API_BASE_URL=

# Плашка «демо-данные». Пока значение не live, сайт честно показывает, что данные демонстрационные.
# С реальным бэком и реальными событиями поставьте live.
NEXT_PUBLIC_DATA_MODE=demo

# ── Ссылки ────────────────────────────────────────────────────────────
# Адрес Telegram-бота, например https://t.me/имя_бота. Пусто: кнопка бота помечена «скоро».
NEXT_PUBLIC_TELEGRAM_BOT_URL=

# ── Админка /admin (только сервер, в браузер не попадает) ─────────────
# Токен модератора. Заглушка ниже только для примера: в бою задайте длинную случайную строку,
# например `openssl rand -hex 32`. С подключённым бэком значение должно совпадать с токеном бэка:
# сайт пересылает запросы админки в бэк с заголовком Authorization: Bearer <ADMIN_TOKEN>.
# Пусто: в разработке админка открыта без входа, в production выключена (ответ 503).
ADMIN_TOKEN=change-me-to-a-long-random-string
# Открыть админку без токена (только для локального демо). В production бэкенд такой запуск отвергает.
ADMIN_OPEN=

# ── Прокси и адрес клиента ────────────────────────────────────────────
# 1: сайт передаёт в бэк X-Forwarded-For с адресом клиента. Включать только когда сайт
# стоит за доверенным reverse proxy, который сам перезаписывает этот заголовок.
# По умолчанию 0: бэк берёт адрес сокета, поддельный X-Forwarded-For ни на что не влияет.
TRUST_PROXY_CLIENT_IP=0

# Публичный адрес сайта. Если задан, используется в canonical/OG и примерах кода
# вместо Host/X-Forwarded-Host (защита от host header injection).
PUBLIC_WEB_URL=http://localhost:3210

# Файл, где админка на моках хранит правки, импорты и журнал.
# По умолчанию .next/cache/afisha/admin-state.json. С подключённым бэком не используется.
AFISHA_DATA_FILE=

# ── Демо ──────────────────────────────────────────────────────────────
# 1: ассистент на моках отвечает 503, и /ask показывает резервный обычный поиск.
ASSISTANT_DISABLED=
