{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://spec.openapis.org/oas/3.1/dialect/2024-11-10",
  "info": {
    "title": "Afisha Curator Session and Public Occurrence API",
    "version": "0.1.0-research",
    "description": "Research contract for Issue #13. No live server, real event or production behavior is asserted. Every accepted SessionPatch increments session_revision. Search, plan and replacement previews have separate allowlists. Saved plans are immutable; reject retains attention. All POST operations require the project Idempotency-Key convention. WidgetCapability is read-only and is accepted only for public occurrence details; it never authorizes session previews, patches, accepts or rejections. Cookie-based deployments must add CSRF protection."
  },
