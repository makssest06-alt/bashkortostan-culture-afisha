{
  "name": "afisha-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Telegram-бот афиши культуры Башкортостана: канал к REST API v1",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "smoke": "tsx src/smoke.ts"
  },
  "dependencies": {
    "grammy": "^1.46.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
