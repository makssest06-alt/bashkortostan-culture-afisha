# Токен от @BotFather. В репозиторий и логи не попадает.
TELEGRAM_BOT_TOKEN=

# Адрес REST API v1 без /api/v1 на конце.
# Локально: http://localhost:8000
# В общем compose с бэкендом: http://api:8000
API_BASE_URL=http://localhost:8000

# Сколько ждать ответа API, миллисекунды.
API_TIMEOUT_MS=10000

# Сколько раз повторять GET при сети, таймауте, 429 и 5xx. 0 — выключить.
API_RETRY_ATTEMPTS=2

# debug | info | warn | error
LOG_LEVEL=info

# Необязательно: публичный адрес сайта для кнопки «Открыть на сайте».
# PUBLIC_WEB_URL=http://localhost:3210

# Сколько живёт состояние диалога, минуты.
SESSION_TTL_MINUTES=120

# Сколько живут callback-токены inline-кнопок, минуты.
CALLBACK_TTL_MINUTES=720

# Лимит действий на пользователя в минуту. 0 — выключить лимит.
RATE_LIMIT_PER_MINUTE=20

# Необязательно: отдельный ключ HMAC для псевдонимов пользователя в логах.
# Если пусто, используется TELEGRAM_BOT_TOKEN. Смена ключа разрывает
# корреляцию старых и новых логов.
# LOG_HASH_SECRET=

# Ключ HMAC для user_ref подписок. Если пусто — LOG_HASH_SECRET, затем токен.
# При смене ключа старые подписки перестанут находиться: это pre-release.
# USER_REF_SECRET=

# hmac — непредсказуемый user_ref (по умолчанию), legacy — откат к telegram_00000123.
# USER_REF_MODE=hmac

# Адаптер ассистента: POST /assistant/query. По умолчанию выключен.
# При 404/5xx/таймауте бот возвращается к обычному поиску.
# ASSISTANT_ENABLED=0
# Подтверждения действий. Не включать до исправления P0-4 в PR #19.
# ASSISTANT_CONFIRMATIONS=0

# Картинка-жетон для /start. По умолчанию assets/token-height.png.
# off — отправлять /start без картинки.
# BRAND_IMAGE_PATH=off
