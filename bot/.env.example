# Токен от @BotFather. В репозиторий и логи не попадает.
TELEGRAM_BOT_TOKEN=

# Адрес REST API v1 без /api/v1 на конце.
# Локально: http://localhost:8000
# В общем compose с бэкендом: http://api:8000
API_BASE_URL=http://localhost:8000

# Сколько ждать ответа API, миллисекунды.
API_TIMEOUT_MS=10000

# debug | info | warn | error
LOG_LEVEL=info

# Необязательно: публичный адрес сайта для кнопки «Открыть на сайте».
# PUBLIC_WEB_URL=http://localhost:3210
