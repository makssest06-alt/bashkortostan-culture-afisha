# Переменные окружения для запуска полного стека (`docker compose up --build` или локально).
# Скопируйте этот файл в `.env` в корне репозитория и при необходимости заполните секреты.
# Файл `.env` в `.gitignore` — реальные ключи и токены в репозиторий не попадают.

# ── База данных PostgreSQL 16 ────────────────────────────────────────────
POSTGRES_USER=afisha
POSTGRES_PASSWORD=afisha
POSTGRES_DB=afisha
# Для docker compose подставляется автоматически как postgresql://afisha:afisha@postgres:5432/afisha.
# Для локального запуска `backend` без внешнего PostgreSQL оставьте пустым — включится встроенный PGlite (./data/pglite).
DATABASE_URL=

# ── Порты сервисов ──────────────────────────────────────────────────────
WEB_PORT=3210
# API не публикуется наружу: docker compose биндит порт только на 127.0.0.1 (P0-2).
API_PORT=8000

# ── Подключение сайта (web/) к бэкенду (backend/) ────────────────────────
# Внутри docker compose сервис бэкенда называется `api`: http://api:8000
# Для локального запуска `web` + `backend` на одной машине укажите http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE_URL=http://api:8000
# Публичный адрес сайта (используется для ссылок в карточках/оповещениях)
PUBLIC_WEB_URL=http://localhost:3210
# Значение `live` убирает плашку «демо-данные» (ставить только с реальным каталогом)
NEXT_PUBLIC_DATA_MODE=demo
# Ссылка на Telegram-бота, например https://t.me/my_afisha_bot (необязательно)
NEXT_PUBLIC_TELEGRAM_BOT_URL=

# ── Админка (/admin и /api/v1/admin/*) ───────────────────────────────────
# Сайт и бэкенд должны использовать одинаковый токен модератора.
# Заглушка `change-me-to-a-long-random-string` автоматически отклоняется в production;
# сгенерируйте случайный токен (`openssl rand -hex 32`) или включите ADMIN_OPEN=1 для локального демо.
ADMIN_TOKEN=change-me-to-a-long-random-string
# `1` открывает админку без токена. Только для локального демо: в production
# (NODE_ENV=production) бэкенд с ADMIN_OPEN=1 не стартует, а ADMIN_TOKEN
# обязателен и не короче 32 символов. По умолчанию — пусто (админка закрыта).
ADMIN_OPEN=

# ── ИИ-агент (/api/v1/assistant/query и инструменты п. 7.2) ──────────────
# `1` принудительно отключает модель (включает 503 + резервный поиск на /ask и в боте).
ASSISTANT_DISABLED=
# Ключ OpenAI-совместимого API. Если пуст — работает детерминированный ИИ-пайплайн (`engine: "rules-v2"`).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=12000
LLM_COST_IN_RUB_PER_1K=0.015
LLM_COST_OUT_RUB_PER_1K=0.06
# P0-3: лимиты и дневной бюджет ассистента (на IP и на user_ref).
# При исчерпании бюджета LLM отключается, ассистент отвечает по rules-движку (`rules-budget-v2`).
ASSISTANT_RATE_LIMIT_10M=20
ASSISTANT_DAILY_LIMIT=200
ASSISTANT_CONFIRM_LIMIT_10M=20
ASSISTANT_MAX_TOKENS=800
ASSISTANT_DAILY_BUDGET_RUB=100

# ── Telegram-бот (bot/) ──────────────────────────────────────────────────
# Токен обязателен: без него контейнер бота завершится с понятной ошибкой.
# Сайт и API при этом поднимутся независимо.
TELEGRAM_BOT_TOKEN=
BOT_LOG_LEVEL=info
BOT_SESSION_TTL_MINUTES=120
BOT_CALLBACK_TTL_MINUTES=720
BOT_RATE_LIMIT_PER_MINUTE=20
# Адаптер ассистента и подтверждения действий в боте (по умолчанию выключены).
BOT_ASSISTANT_ENABLED=0
BOT_ASSISTANT_CONFIRMATIONS=0
# HMAC-ключи для user_ref подписок и псевдонимов в логах (необязательны).
# USER_REF_MODE=hmac
# LOG_HASH_SECRET=
# USER_REF_SECRET=

# ── Приватность, хранение и лимиты ───────────────────────────────────────
# Срок хранения обращений обратной связи в БД (дней)
FEEDBACK_RETENTION_DAYS=90
# Ограничение частоты запросов к /metrics с одного IP в минуту
METRICS_RATE_LIMIT=120
# Токен для /metrics: в production без него метрики скрыты (404); минимум 32 символа.
METRICS_TOKEN=
# Лимит публичных GET на IP в минуту (backstop от scraping)
READ_RATE_LIMIT=600
# Доверять X-Forwarded-For (`0` — не доверять, адрес берётся из сокета;
# `1` — один доверенный прокси; N — N доверенных прокси, адрес берётся с конца цепочки).
# Включаем только за известным reverse proxy (P0-2).
TRUST_PROXY=0

# ── Retention чувствительных данных ─────────────────────────────────────
ASSISTANT_TRACE_RETENTION_DAYS=30
CONFIRMATION_RETENTION_DAYS=7
RAW_RECORD_RETENTION_DAYS=180
IMPORT_RETENTION_DAYS=180
AUDIT_RETENTION_DAYS=365
SUBSCRIPTION_INACTIVE_DAYS=180
